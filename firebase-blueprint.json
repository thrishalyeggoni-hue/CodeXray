{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "AnalysisHistory": {
      "title": "Code Analysis History",
      "description": "Saved code analyses for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "code": { "type": "string", "maxLength": 50000 },
        "language": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "code", "language"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "AnalysisHistory",
      "description": "User code analysis history subcollection"
    }
  }
}
